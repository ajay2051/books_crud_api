# Copy to .env and change the secrets:  cp .env.example .env
PORT=8080
GIN_MODE=debug
RUN_MIGRATIONS=true

# Used by docker-compose (database container + API container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=booksdb

# Used when you run the app on your machine (go run / make run / make migrate-up).
# Host is "localhost" here; docker-compose builds its own URL with host "db".
DATABASE_URL=postgres://postgres:change-me@localhost:5432/booksdb?sslmode=disable

# JWT. Generate a secret with:  openssl rand -base64 48   (minimum 32 characters)
# Never commit the real value, and use a different one in every environment.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ISSUER=golang_crud
ACCESS_TOKEN_TTL=1h